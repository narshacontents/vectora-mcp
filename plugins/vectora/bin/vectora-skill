#!/bin/sh
# Vectora 2.3.2: runs vectora-skill for this system from bin/<platform>/ (macos-aarch64).
# Windows starts bin/vectora-skill.exe instead.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 70
case "$(uname -s) $(uname -m)" in
  "Darwin arm64") platform=macos-aarch64 ;;
  *) printf '%s\n' "Vectora: no vectora-skill for $(uname -s) $(uname -m) in this plugin." >&2; exit 69 ;;
esac
exec "$here/$platform/vectora-skill" "$@"
